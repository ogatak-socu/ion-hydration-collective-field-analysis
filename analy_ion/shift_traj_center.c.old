#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#include <time.h>
#include <math.h>

#include "cal_vector.h"

static int check_center_in_box(XYZ_T *,XYZ_T *);
static void shift_mol_in_box_x(XYZ_T *,XYZ_T *,int ,int ,XYZ_T *);
static void shift_mol_in_box_y(XYZ_T *,XYZ_T *,int ,int ,XYZ_T *);
static void shift_mol_in_box_z(XYZ_T *,XYZ_T *,int ,int ,XYZ_T *);
static void shift_element_x(XYZ_T *,int ,int ,double );
static void shift_element_y(XYZ_T *,int ,int ,double );
static void shift_element_z(XYZ_T *,int ,int ,double );
static double atom_inbox_element(double ,double );

void shift_traj_center(TRAJ *traj,XYZ_T *p0,int natom)
{
	int i;
	double x,y,z;

	for(i = 0; i < natom; i++){
		x = (traj->mdcrd+i)->x - p0->x;
		y = (traj->mdcrd+i)->y - p0->y;
		z = (traj->mdcrd+i)->z - p0->z;
		(traj->mdcrd+i)->x = atom_inbox_element(x,(traj->box)->x);
		(traj->mdcrd+i)->y = atom_inbox_element(y,(traj->box)->y);
		(traj->mdcrd+i)->z = atom_inbox_element(z,(traj->box)->z);
	}
}

void shift_traj_center_res(TRAJ *traj,XYZ_T *p0,PRMTOP *prmtop)
{
        int k,i,sp,ep;
        double x,y,z;
        XYZ_T w;

        for(k = 0; k < prmtop->nres; k++){
                get_prmtop_sp_ep_idx(prmtop,k+1,k+1,&sp,&ep);
                for(i = sp; i <= ep; i++){
                        (traj->mdcrd+i)->x -= p0->x;
                        (traj->mdcrd+i)->y -= p0->y;
                        (traj->mdcrd+i)->z -= p0->z;
                }
                get_mass_center_res(&w,traj->mdcrd,sp,ep);
                if(check_center_in_box(&w,traj->box) == 1){
                        shift_mol_in_box_x(&w,traj->mdcrd,sp,ep,traj->box);
                        shift_mol_in_box_y(&w,traj->mdcrd,sp,ep,traj->box);
                        shift_mol_in_box_z(&w,traj->mdcrd,sp,ep,traj->box);
                }
        }
}

static int check_center_in_box(XYZ_T *p,XYZ_T *box)
{
	if(p->x > box->x/2.0 || p->x < -box->x/2.0)
		return 1;
	if(p->y > box->y/2.0 || p->y < -box->y/2.0)
		return 1;
	if(p->z > box->z/2.0 || p->z < -box->z/2.0)
		return 1;
	return 0;
}

static void shift_mol_in_box_x(XYZ_T *mass,XYZ_T *mdcrd,int sp,int ep,XYZ_T *box)
{
	int i;
	double bx;

	bx = box->x/2.0;
	if(mass->x > bx)
		shift_element_x(mdcrd,sp,ep,2.0*bx);
	else{
		if(mass->x < -bx)
			shift_element_x(mdcrd,sp,ep,-2.0*bx);
	}
}

static void shift_mol_in_box_y(XYZ_T *mass,XYZ_T *mdcrd,int sp,int ep,XYZ_T *box)
{
	int i;
	double by;

	by = box->y/2.0;
	if(mass->y > by)
		shift_element_y(mdcrd,sp,ep,2.0*by);
	else{
		if(mass->y < -by)
			shift_element_y(mdcrd,sp,ep,-2.0*by);
	}
}

static void shift_mol_in_box_z(XYZ_T *mass,XYZ_T *mdcrd,int sp,int ep,XYZ_T *box)
{
	int i;
	double bz;

	bz = box->z/2.0;
	if(mass->z > bz)
		shift_element_z(mdcrd,sp,ep,2.0*bz);
	else{
		if(mass->z < -bz)
			shift_element_z(mdcrd,sp,ep,-2.0*bz);
	}
}

static void shift_element_x(XYZ_T *mdcrd,int sp,int ep,double bx)
{
	int i;

	for(i = sp; i <= ep; i++)
		(mdcrd+i)->x -= bx;
}

static void shift_element_y(XYZ_T *mdcrd,int sp,int ep,double by)
{
	int i;

	for(i = sp; i <= ep; i++)
		(mdcrd+i)->y -= by;
}

static void shift_element_z(XYZ_T *mdcrd,int sp,int ep,double bz)
{
	int i;

	for(i = sp; i <= ep; i++)
		(mdcrd+i)->z -= bz;
}

static double atom_inbox_element(double x,double box)
{
	if(x > box/2.0)
		return x - box;
	else{
		if(x < -box/2.0)
			return x + box;
		else
			return x;
	}
	fprintf(stderr,"Error  atom_inbox_element\n");
}

